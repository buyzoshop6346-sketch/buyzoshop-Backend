

model PersonalEntry {
  id               String          @id @default(cuid())

  date             DateTime
  description      String
  amount           Decimal         @db.Decimal(12, 2)

  status           PersonalEntryStatus
  type             PersonalEntryType

  quantity         Int?
  priceRmb         Decimal?        @db.Decimal(12, 2)
  shippingCharge   Decimal?        @db.Decimal(12, 2)

  paidReceivedBy   String?
  platform         String?

  clearanceStatus  ClearanceStatus @default(PENDING)

  accountType      AccountType     @default(PERSONAL)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt


  @@map("personal_entries")
}