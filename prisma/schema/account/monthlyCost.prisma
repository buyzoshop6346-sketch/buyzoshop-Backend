

model FixedMonthlyCost {
  id          String                  @id @default(uuid())
  date        DateTime
  description String
  amount      Decimal                 @db.Decimal(12, 2)
  status      FixedMonthlyCostStatus  @default(UNPAID)

  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

 
  @@map("fixed_monthly_costs")
}