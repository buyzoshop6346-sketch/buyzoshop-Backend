model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  // BASIC INFORMATION

  brand      String?
  categoryId String

  category Category @relation( fields: [categoryId],references: [id])

  tags String[] @default([])

  // MEDIA

  thumbnail String
  images    String[] @default([])
  videoUrl  String?

  // SPECIFICATION

  model    String?
  material String?

  // PRICING & STOCK

  price        Float
  specialPrice Float?
  discount     Float?
  stock        Int @default(0)

  // SHIPPING

  weight Float?

  // Example:
  // {
  //   "length": 30,
  //   "width": 20,
  //   "height": 10
  // }
  dimensions Json?

  dangerousGoods Boolean @default(false)

  // WARRANTY

  warrantyType   String?
  warrantyPeriod String?

  // PRODUCT HIGHLIGHTS

  highlights String[] @default([])

  // PRODUCT RATING & REVIEWS
  // Review data will be managed from Review module

  rating      Float @default(0)
  reviewCount Int   @default(0)

  // PRODUCT ENGAGEMENT

  viewCount Int @default(0)
  likeCount Int @default(0)

  // PRODUCT STATUS

  isFeatured  Boolean @default(false)
  isPublished Boolean @default(true)

  // COLOR VARIANTS

  colorVariants ProductColorVariant[]

  // REVIEWS
  // Relation with separate Review model/module

  reviews Review[]

  // EXISTING RELATIONS

  orderItems OrderItem[]
  carts      Cart[]
  wishlist  Wishlist[]

  // TIMESTAMPS

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ProductColorVariant {
  id        String @id @default(uuid())
  productId String

  product Product @relation(fields: [productId],references: [id],    onDelete: Cascade )

  // Example:
  // Green
  // Black
  // Red

  color String

  // Color-specific image

  image String?

  // Sizes of this color

  sizes ProductSizeVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ProductSizeVariant {
  id             String @id @default(uuid())
  colorVariantId String

  colorVariant ProductColorVariant @relation(    fields: [colorVariantId],references: [id],    onDelete: Cascade)

  // Example:
  // 36
  // 38
  // 40
  // XL
  // XXL

  size String

  price        Float
  specialPrice Float?
  stock        Int @default(0)

  // Example:
  // GREEN-36
  // BLACK-40

  sku String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([colorVariantId, size])
}